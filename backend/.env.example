# Bustler Backend — Environment Variables
# Copy this file to .env and fill in your values.

# Google Cloud Project ID (required for Firestore)
GCP_PROJECT_ID=your-gcp-project-id

# Path to Firebase/GCP service account key JSON (required for Firestore outside Cloud Run)
# On Cloud Run, this is auto-provided — leave empty.
GOOGLE_APPLICATION_CREDENTIALS=

# Port for the Express server (Cloud Run sets this automatically)
PORT=8080
# Groq API Key (server-side only)
GROQ_API_KEY=your-groq-api-key-here

# API Secret — shared secret for API access control in production.
# When set, all /api requests must include an X-Api-Secret header with this value.
# Leave empty for local development (no secret check).
API_SECRET=
